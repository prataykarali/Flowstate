  "cards": [
    {
      "dot": "cyan",
      "title": "GQA Head Sharing",
      "items": [
        "4 query heads share 2 key/value heads, reducing KV cache and projection parameter footprint by 50%",
        "repeat_interleave broadcasts the 2 KV heads across adjacent query heads before dot-product attention",
        "Head dimension is 32; total model dimension remains 4 * 32 = 128"
      ]
    },
    {
      "dot": "emerald",
      "title": "Rotary Position Embedding (RoPE)",
      "items": [
        "Rotates adjacent feature pairs in Q and K by position-dependent angles with base frequency 10000.0",
        "Preserves vector norms while encoding relative token distance directly into the attention inner product",
        "Position 0 undergoes zero rotation (identity), preserving first-token representation"
      ]
    },
    {
      "dot": "rose",
      "title": "Causality & Decoupled State",
      "items": [
        "Lower-triangular causal mask enforces strict autoregressive factorization (future tokens masked to -inf)",
        "Chapter 1 tests verify prefix-invariance: modifying future tokens does not alter past output logits",
        "Operates as Layer 3 in the hybrid pipeline, complementing the 3 recurrent GatedDeltaNet layers"
      ]
    }
  ]
