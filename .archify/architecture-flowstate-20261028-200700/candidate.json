  "cards": [
    {
      "dot": "cyan",
      "title": "Chapter 1 Trained Decoder",
      "items": [
        "4-layer mini hybrid: 3 GatedDeltaNet recurrent layers + 1 causal GQA layer",
        "RMSNorm pre-normalization, SwiGLU feed-forward, and residual connections throughout",
        "256-byte vocabulary with 128 hidden dimension; next-token cross-entropy objective"
      ]
    },
    {
      "dot": "amber",
      "title": "Chapter 2 Standalone KV Research",
      "items": [
        "Component-level investigation of associative memory and delta-rule updates",
        "Overlapping keys introduce interference (L2 error ~1.01); orthogonal keys & slots eliminate it in synthetic tests",
        "Chapter 2 external memory mechanisms are standalone benchmarks, NOT integrated into the Chapter 1 decoder"
      ]
    },
    {
      "dot": "rose",
      "title": "Educational Status & Limits",
      "items": [
        "Educational Qwen3.5-inspired architecture; not official Qwen3.5 or Liquid AI code",
        "Zero-error results reflect synthetic, idealized one-hot keys and exclude runtime index overhead",
        "Confidence gating (threshold 0.80) trades coverage (100% -> 45%) for accepted accuracy under noise"
      ]
    }
