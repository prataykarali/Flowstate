{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/((?!api/|assets/|research/|runner-prototype/|samples/).*)", "destination": "/index.html" }],
  "functions": {
    "api/session.js": { "maxDuration": 10 }
  }
}
